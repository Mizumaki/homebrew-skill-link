#!/usr/bin/env bash
# skill-link — manage agent skill symlinks (Claude Code, Codex, ...)
#
# Usage:
#   skill-link init      Create an empty skill-link.conf template (no-op if
#                        the file already exists)
#   skill-link sync      Create symlinks for skills in configured dirs and
#                        remove stale symlinks that no longer match the conf
#                        (--dry-run: show the changes without making them)
#   skill-link list      Show all skills and their link status
#   skill-link clean     Remove broken symlinks from every target
#
# Configuration:
#   ${XDG_CONFIG_HOME:-~/.config}/skill-link/skill-link.conf
#   INI-style sections, # = comment. Three sections:
#     [targets] Each line points to a skills directory an agent reads
#               (e.g. ~/.claude/skills, ~/.agents/skills). Every skill is
#               linked into every target. At least one target is required.
#     [dirs]    Each line points to a parent directory; every direct
#               subdirectory is linked as a skill.
#     [skills]  Each line points to a single skill directory containing
#               SKILL.md.
#
#   Within [dirs] and [skills], two line forms are accepted:
#     <path>                   plain entry; symlink name = basename(path)
#     <prefix> = <path>        prefixed entry; symlink name = "<prefix>:<basename>"
#
#   If the file does not exist, an error is raised.

set -euo pipefail

VERSION="1.3.0"

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/skill-link"
CONF_FILE="$CONF_DIR/skill-link.conf"

# Populated by load_conf. Entries keep conf order so that the first entry
# wins on a name collision.
TARGETS=()
ENTRY_TYPES=()      # conf section: `dirs` or `skills`
ENTRY_PATHS=()      # expanded path without trailing slash
ENTRY_PREFIXES=()   # empty for plain entries

# Populated by _resolve_skills: every skill dir the entries expand to, in
# conf order, with the symlink name it gets in each target.
SKILL_PATHS=()      # without trailing slash
SKILL_NAMES=()      # basename, or "<prefix>:<basename>"

# Set by `sync --dry-run`: report what would change without touching links.
DRY_RUN=0

usage() {
  cat <<EOF
Usage: skill-link <command>

Commands:
  init      Create skill-link.conf from a template (only if it does not exist)
  sync      Create symlinks for skills in configured dirs and remove stale
            symlinks (those whose source dir is no longer in conf)
            --dry-run  show what would change without touching anything
  list      Show all skills and their link status
  clean     Remove broken symlinks

Options:
  --version Show version and exit
  -h, --help Show this help and exit

Configuration:
  $CONF_FILE — INI-style sections (# = comment). Required.
    [targets]             skills dirs to link into (at least one required),
                          e.g. ~/.claude/skills or ~/.agents/skills
    [dirs]                parent dirs; every subdirectory is linked
    [skills]              single-skill dirs (must contain SKILL.md)
    <prefix> = <path>     in [dirs]/[skills], name the symlink "<prefix>:<name>"
EOF
}

# Parse $CONF_FILE into TARGETS and ENTRY_* arrays. Exits on any error, so
# callers can rely on a valid conf with at least one target afterwards.
load_conf() {
  if [[ ! -f "$CONF_FILE" ]]; then
    echo "Error: $CONF_FILE not found." >&2
    echo "Run 'skill-link init' to create it from a template." >&2
    exit 1
  fi

  local lineno=0 section="" line stripped key value path prefix
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    stripped="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
    stripped="${stripped%"${stripped##*[![:space:]]}"}"   # trim trailing whitespace
    [[ -z "$stripped" ]] && continue
    [[ "$stripped" == \#* ]] && continue

    if [[ "$stripped" =~ ^\[(.*)\]$ ]]; then
      local name="${BASH_REMATCH[1]}"
      case "$name" in
        targets|dirs|skills) section="$name" ;;
        *)
          echo "Error: $CONF_FILE: unknown section [$name] (line $lineno)" >&2
          exit 1
          ;;
      esac
      continue
    fi

    if [[ -z "$section" ]]; then
      echo "Error: $CONF_FILE: entry before any [targets]/[dirs]/[skills] section (line $lineno)" >&2
      exit 1
    fi

    prefix=""
    if [[ "$stripped" == *"="* ]]; then
      key="${stripped%%=*}"
      value="${stripped#*=}"
      key="${key%"${key##*[![:space:]]}"}"
      key="${key#"${key%%[![:space:]]*}"}"
      value="${value#"${value%%[![:space:]]*}"}"
      value="${value%"${value##*[![:space:]]}"}"
      if [[ -z "$key" ]]; then
        echo "Error: $CONF_FILE: empty prefix before '=' (line $lineno)" >&2
        exit 1
      fi
      if [[ ! "$key" =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "Error: $CONF_FILE: invalid prefix '$key' (line $lineno)" >&2
        exit 1
      fi
      if [[ -z "$value" ]]; then
        echo "Error: $CONF_FILE: missing path for prefix '$key' (line $lineno)" >&2
        exit 1
      fi
      prefix="$key"
      path="$value"
    else
      path="$stripped"
    fi

    path="$(eval echo "$path")"
    path="${path%/}"
    if [[ "$section" == targets ]]; then
      if [[ -n "$prefix" ]]; then
        echo "Error: $CONF_FILE: prefix is not allowed in [targets] (line $lineno)" >&2
        exit 1
      fi
      TARGETS+=("$path")
    else
      ENTRY_TYPES+=("$section")
      ENTRY_PATHS+=("$path")
      ENTRY_PREFIXES+=("$prefix")
    fi
  done < "$CONF_FILE"

  if (( ${#TARGETS[@]} == 0 )); then
    cat >&2 <<EOF
Error: $CONF_FILE: no [targets] entries.
List at least one skills directory to link into, e.g. ~/.claude/skills
(Claude Code) or ~/.agents/skills (Codex).
EOF
    exit 1
  fi
}

cmd_init() {
  if [[ -e "$CONF_FILE" ]]; then
    echo "$CONF_FILE already exists. Leaving it untouched."
    return
  fi
  mkdir -p "$CONF_DIR"
  cat > "$CONF_FILE" <<'EOF'
# skill-link configuration (https://github.com/Mizumaki/homebrew-skill-link)
#
# [targets] — each line points to a skills directory an agent reads.
# Every skill below is linked into every target. At least one target is
# required; uncomment the agents you use.
#
# [dirs] — each line points to a parent directory; every direct
# subdirectory is linked as a skill into each target.
#
# [skills] — each line points to a single skill directory containing
# SKILL.md. The directory itself is linked.
#
# Within [dirs] and [skills], write a plain path for an unprefixed entry,
# or "<prefix> = <path>" to namespace the resulting symlink as
# "<prefix>:<name>" — e.g. matt = ~/dev/personal-skills/skills produces
# <target>/matt:<subdir> entries.
#
[targets]
# Claude Code
# ~/.claude/skills
# Codex
# ~/.agents/skills

[dirs]
# ~/Documents/dev/personal-skills/skills
# work = ~/Documents/dev/work-skills/skills

[skills]
# ~/Documents/dev/work/special-skill
# matt = ~/Documents/dev/personal/tdd-skill
EOF
  echo "Created $CONF_FILE"
  echo "Edit it to list your targets and skill directories, then run 'skill-link sync'."
}

# Expand the conf entries into SKILL_PATHS / SKILL_NAMES, warning once about
# entries that do not resolve to any skill.
_resolve_skills() {
  local i path prefix skill_path
  for i in "${!ENTRY_TYPES[@]}"; do
    path="${ENTRY_PATHS[$i]}"
    prefix="${ENTRY_PREFIXES[$i]}"
    case "${ENTRY_TYPES[$i]}" in
      dirs)
        if [[ ! -d "$path" ]]; then
          echo "  [warn] $path not found, skipping."
          continue
        fi
        for skill_path in "$path"/*/; do
          [[ -d "$skill_path" ]] || continue
          _add_skill "${skill_path%/}" "$prefix"
        done
        ;;
      skills)
        if [[ ! -d "$path" || ! -f "$path/SKILL.md" ]]; then
          echo "  [warn] $path is not a skill (missing dir or no SKILL.md), skipping."
          continue
        fi
        _add_skill "$path" "$prefix"
        ;;
    esac
  done
}

_add_skill() {
  local skill_path="$1" prefix="$2"
  SKILL_PATHS+=("$skill_path")
  SKILL_NAMES+=("${prefix:+$prefix:}${skill_path##*/}")
}

# Link a single skill dir into a target dir (only report it under DRY_RUN).
# Relies on dynamic scope for the caller's linked/kept/skipped counters.
_link_one() {
  local skill_path="$1" link_name="$2" target_dir="$3"
  local target="$target_dir/$link_name"
  if [[ -L "$target" && -e "$target" ]]; then
    ((kept++)) || true
  elif [[ -L "$target" && ! -e "$target" ]]; then
    (( DRY_RUN )) || { rm "$target"; ln -s "$skill_path" "$target"; }
    echo "  [relink] $link_name -> $skill_path (was broken)"
    ((linked++)) || true
  elif [[ -e "$target" ]]; then
    echo "  [skip] $link_name (exists but not a symlink)"
    ((skipped++)) || true
  else
    (( DRY_RUN )) || ln -s "$skill_path" "$target"
    echo "  [link] $link_name -> $skill_path"
    ((linked++)) || true
  fi
}

# Link every resolved skill into every target. $1 is the number of stale
# links sync removed (or would remove), reported in the dry-run summary.
cmd_install() {
  local removed="$1"
  _resolve_skills
  local linked=0 kept=0 skipped=0 target_dir i before
  for target_dir in "${TARGETS[@]}"; do
    (( DRY_RUN )) || mkdir -p "$target_dir"
    echo "==> $target_dir"
    before=$((linked + skipped))
    for i in "${!SKILL_PATHS[@]}"; do
      _link_one "${SKILL_PATHS[$i]}/" "${SKILL_NAMES[$i]}" "$target_dir"
    done
    (( linked + skipped > before )) || echo "  (no changes)"
  done
  echo ""
  if (( DRY_RUN )); then
    echo "Dry run: $linked would be linked, $removed would be removed, $kept kept, $skipped skipped."
  else
    echo "Done: $linked linked, $kept kept, $skipped skipped."
  fi
}

cmd_list() {
  load_conf

  local target_dir
  echo "Configured targets:"
  for target_dir in "${TARGETS[@]}"; do
    echo "  $target_dir"
  done

  echo ""
  echo "Configured directories:"
  _print_entries dirs
  local skills
  skills="$(_print_entries skills)"
  if [[ -n "$skills" ]]; then
    echo ""
    echo "Configured skills:"
    echo "$skills"
  fi

  _resolve_skills >/dev/null
  for target_dir in "${TARGETS[@]}"; do
    echo ""
    _list_target "$target_dir"
  done
}

# Print the conf entries of one section, annotated with their prefix.
_print_entries() {
  local section="$1" i
  for i in "${!ENTRY_TYPES[@]}"; do
    [[ "${ENTRY_TYPES[$i]}" == "$section" ]] || continue
    if [[ -n "${ENTRY_PREFIXES[$i]}" ]]; then
      echo "  ${ENTRY_PREFIXES[$i]}: ${ENTRY_PATHS[$i]}"
    else
      echo "  ${ENTRY_PATHS[$i]}"
    fi
  done
}

# Print the link status of every entry in one target dir, followed by
# resolved skills that are not linked there yet.
_list_target() {
  local target_dir="$1"
  echo "Skills in $target_dir:"

  local found=0 entry name
  if [[ -d "$target_dir" ]]; then
    for entry in "$target_dir"/*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      name="${entry##*/}"
      if [[ -L "$entry" ]]; then
        local dest
        dest="$(readlink "$entry")"
        if [[ -e "$entry" ]]; then
          echo "  [linked] $name -> $dest"
        else
          echo "  [broken] $name -> $dest (target missing)"
        fi
      else
        echo "  [manual] $name"
      fi
      ((found++)) || true
    done
  fi

  local i
  for i in "${!SKILL_PATHS[@]}"; do
    entry="$target_dir/${SKILL_NAMES[$i]}"
    if [[ ! -e "$entry" && ! -L "$entry" ]]; then
      echo "  [unlinked] ${SKILL_NAMES[$i]} -> ${SKILL_PATHS[$i]} (run 'skill-link sync')"
      ((found++)) || true
    fi
  done

  [[ $found -gt 0 ]] || echo "  (none)"
}

# True when the symlink destination comes from a conf entry: its parent is a
# [dirs] entry, or it is itself a [skills] entry.
_in_conf() {
  local dest_clean="${1%/}" i
  local parent="${dest_clean%/*}"
  for i in "${!ENTRY_TYPES[@]}"; do
    case "${ENTRY_TYPES[$i]}" in
      dirs)   [[ "$parent" == "${ENTRY_PATHS[$i]}" ]] && return 0 ;;
      skills) [[ "$dest_clean" == "${ENTRY_PATHS[$i]}" ]] && return 0 ;;
    esac
  done
  return 1
}

cmd_sync() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN=1 ;;
      *)
        echo "Error: unknown option for sync: $arg" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  load_conf

  # Collect symlinks, across all targets, whose source is no longer in conf.
  local -a stale=()
  local target_dir entry
  for target_dir in "${TARGETS[@]}"; do
    [[ -d "$target_dir" ]] || continue
    for entry in "$target_dir"/*; do
      [[ -L "$entry" ]] || continue
      _in_conf "$(readlink "$entry")" || stale+=("$entry")
    done
  done

  if [[ ${#stale[@]} -eq 0 ]]; then
    echo "No stale symlinks found."
  elif (( DRY_RUN )); then
    for entry in "${stale[@]}"; do
      echo "  [remove] ${entry##*/} (from ${entry%/*})"
    done
  else
    echo "The following symlinks will be removed:"
    for entry in "${stale[@]}"; do
      echo "  $entry -> $(readlink "$entry")"
    done
    echo ""
    if ! read -r -p "Proceed? [y/N] " answer || [[ ! "$answer" =~ ^[Yy]$ ]]; then
      echo "Aborted."
      exit 0
    fi
    echo ""

    local removed=0
    for entry in "${stale[@]}"; do
      rm "$entry"
      echo "  [removed] ${entry##*/} (from ${entry%/*})"
      ((removed++)) || true
    done
    echo "$removed symlink(s) removed."
  fi
  echo ""

  cmd_install "${#stale[@]}"
}

cmd_clean() {
  load_conf

  local removed=0 target_dir entry
  for target_dir in "${TARGETS[@]}"; do
    if [[ ! -d "$target_dir" ]]; then
      echo "No $target_dir directory found."
      continue
    fi
    for entry in "$target_dir"/*; do
      [[ -L "$entry" ]] || continue
      if [[ ! -e "$entry" ]]; then
        rm "$entry"
        echo "  [removed] ${entry##*/} (broken symlink in $target_dir)"
        ((removed++)) || true
      fi
    done
  done
  echo "Done: $removed broken symlinks removed."
}

case "${1:-}" in
  init)            cmd_init ;;
  sync)            shift; cmd_sync "$@" ;;
  list)            cmd_list ;;
  clean)           cmd_clean ;;
  --version)       echo "skill-link $VERSION" ;;
  -h|--help)       usage ;;
  *)               usage; exit 1 ;;
esac
